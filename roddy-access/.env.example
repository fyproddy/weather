# WhatsApp number in international format, digits only (e.g. 27821234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Optional: a form endpoint (Formspree, Basin, your own API) that accepts JSON POSTs.
# When set, plan requests are also sent here before the WhatsApp handoff.
NEXT_PUBLIC_FORM_ENDPOINT=
# Public site URL, used for canonical links, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://roddyaccess.co.za

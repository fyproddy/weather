# Server-side secrets — set these on your host (Vercel → Settings → Environment Variables).
# Plan requests are delivered by /api/request to whichever channels are set.

# WhatsApp delivery to the RODDY ACCESS number (content/site.ts) via CallMeBot.
# Get the key by activating CallMeBot from that phone — see README.
CALLMEBOT_APIKEY=

# Email delivery via Resend (resend.com). Optional but recommended as a backup.
RESEND_API_KEY=
REQUEST_EMAIL_TO=hello@roddyaccess.co.za
# Needs a verified domain on Resend; until then leave empty to use Resend's test sender.
REQUEST_EMAIL_FROM=

# Public site URL, used for canonical links, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://roddyaccess.co.za
